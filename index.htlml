<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PNU Special Lecture // Vibe Coding & Data Applications</title>
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- Chart.js for Thermal Visualizations -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <!-- Google Fonts: Inter & JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">

    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        mono: ['JetBrains Mono', 'monospace'],
                    },
                    colors: {
                        futuristic: {
                            bg: '#FAFCFF',
                            card: '#FFFFFF',
                            border: '#E2E8F0',
                            glow: '#06B6D4',
                            violet: '#8B5CF6',
                            cyan: '#0EA5E9',
                            emerald: '#10B981',
                            textPrimary: '#0F172A',
                            textSecondary: '#64748B'
                        }
                    },
                    boxShadow: {
                        'futuristic': '0 20px 40px -15px rgba(14, 165, 233, 0.07), 0 0 15px 0 rgba(226, 232, 240, 0.8)',
                        'futuristic-hover': '0 25px 50px -12px rgba(14, 165, 233, 0.15), 0 0 25px 2px rgba(14, 165, 233, 0.15)',
                        'glow-cyan': '0 0 20px rgba(14, 165, 233, 0.25)',
                        'glow-violet': '0 0 20px rgba(139, 92, 246, 0.25)'
                    },
                    backgroundImage: {
                        'grid-pattern': 'radial-gradient(circle, rgba(148, 163, 184, 0.15) 1px, transparent 1px)',
                        'hero-gradient': 'linear-gradient(135deg, rgba(255,255,255,0.9) 0%, rgba(240,249,255,0.8) 50%, rgba(245,243,255,0.9) 100%)',
                    }
                }
            }
        }
    </script>

    <style>
        /* Custom Futuristic Styling */
        body {
            background-color: #FAFCFF;
            color: #0F172A;
            background-image: radial-gradient(circle at 1px 1px, rgba(148, 163, 184, 0.12) 1px, transparent 0);
            background-size: 32px 32px;
            transition: background-color 0.3s ease, color 0.3s ease;
        }

        .dark body {
            background-color: #0B0F17;
            color: #F8FAFC;
            background-image: radial-gradient(circle at 1px 1px, rgba(51, 65, 85, 0.3) 1px, transparent 0);
        }

        .glass-panel {
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(226, 232, 240, 0.9);
            transition: all 0.3s ease;
        }

        .dark .glass-panel {
            background: rgba(15, 23, 42, 0.75);
            backdrop-filter: blur(16px);
            border: 1px solid rgba(51, 65, 85, 0.6);
        }

        .glass-panel-interactive {
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(16px);
            border: 1px solid rgba(203, 213, 225, 0.8);
            transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .dark .glass-panel-interactive {
            background: rgba(15, 23, 42, 0.8);
            border: 1px solid rgba(51, 65, 85, 0.8);
        }

        .glass-panel-interactive:hover {
            transform: translateY(-4px);
            border-color: rgba(14, 165, 233, 0.5);
            box-shadow: 0 20px 40px -15px rgba(14, 165, 233, 0.12), 0 0 20px 2px rgba(14, 165, 233, 0.1);
        }

        .shimmer-text {
            background: linear-gradient(120deg, #0F172A 30%, #0EA5E9 50%, #8B5CF6 70%, #0F172A 90%);
            background-size: 200% auto;
            color: transparent;
            -webkit-background-clip: text;
            background-clip: text;
            animation: shimmer 6s linear infinite;
        }

        .dark .shimmer-text {
            background: linear-gradient(120deg, #F8FAFC 30%, #38BDF8 50%, #A78BFA 70%, #F8FAFC 90%);
            background-size: 200% auto;
            color: transparent;
            -webkit-background-clip: text;
            background-clip: text;
        }

        @keyframes shimmer {
            0% { background-position: 0% center; }
            100% { background-position: 200% center; }
        }

        .pulse-light {
            animation: pulseGlow 3s infinite ease-in-out;
        }

        @keyframes pulseGlow {
            0%, 100% { opacity: 0.4; transform: scale(1); }
            50% { opacity: 0.8; transform: scale(1.05); }
        }

        /* Scrollbar styling */
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #F1F5F9;
        }
        .dark ::-webkit-scrollbar-track {
            background: #0F172A;
        }
        ::-webkit-scrollbar-thumb {
            background: #CBD5E1;
            border-radius: 4px;
        }
        .dark ::-webkit-scrollbar-thumb {
            background: #334155;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #94A3B8;
        }
    </style>
</head>
<body class="min-h-screen antialiased flex flex-col justify-between selection:bg-cyan-100 selection:text-cyan-900 dark:selection:bg-cyan-900 dark:selection:text-cyan-100">

    <!-- Header / Navigation -->
    <header class="sticky top-0 z-40 w-full glass-panel border-b border-slate-200/80 dark:border-slate-800">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            <div class="flex items-center space-x-3">
                <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-cyan-500 to-blue-600 flex items-center justify-center text-white shadow-md shadow-cyan-500/20 font-mono font-bold text-lg">
                    P
                </div>
                <div>
                    <span class="font-mono text-xs font-semibold tracking-wider text-cyan-600 dark:text-cyan-400 block uppercase">Pusan National University</span>
                    <span class="font-bold text-slate-900 dark:text-white text-sm sm:text-base tracking-tight">Special Lecture Archive</span>
                </div>
            </div>
            
            <nav class="hidden md:flex items-center space-x-8 text-sm font-medium text-slate-600 dark:text-slate-300">
                <a href="#overview" class="hover:text-cyan-600 dark:hover:text-cyan-400 transition-colors">Lecture Overview</a>
                <a href="#projects" class="hover:text-cyan-600 dark:hover:text-cyan-400 transition-colors">Core Modules</a>
                <a href="#vibe-coding" class="hover:text-cyan-600 dark:hover:text-cyan-400 transition-colors">Vibe Coding Method</a>
            </nav>

            <div class="flex items-center space-x-3">
                <!-- Theme Switcher Button -->
                <button id="theme-toggle" onclick="toggleTheme()" class="p-2 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-200 hover:bg-slate-200 dark:hover:bg-slate-700 transition-all flex items-center justify-center border border-slate-200 dark:border-slate-700 shadow-sm" title="Toggle Light/Dark Theme">
                    <i id="theme-icon" class="fa-solid fa-moon text-sm"></i>
                </button>

                <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-mono font-medium bg-cyan-50 dark:bg-cyan-950/60 text-cyan-700 dark:text-cyan-300 border border-cyan-200 dark:border-cyan-800">
                    <span class="w-2 h-2 rounded-full bg-cyan-500 mr-2 animate-ping"></span>
                    2026 SPECIAL EDITION
                </span>
            </div>
        </div>
    </header>

    <main class="flex-grow">
        <!-- Hero Section -->
        <section id="overview" class="relative py-16 lg:py-24 overflow-hidden">
            <!-- Decorative light background glow vectors -->
            <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[300px] bg-gradient-to-tr from-cyan-200/40 via-sky-200/30 to-violet-200/40 dark:from-cyan-900/30 dark:via-blue-900/20 dark:to-violet-900/30 blur-3xl rounded-full pointer-events-none pulse-light"></div>
            
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
                <div class="text-center max-w-3xl mx-auto">
                    <div class="inline-flex items-center space-x-2 px-3.5 py-1.5 rounded-full bg-slate-100/80 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-300 text-xs font-mono mb-6">
                        <i class="fa-solid font-bold fa-microchip text-cyan-500"></i>
                        <span>PUSAN NATIONAL UNIVERSITY // DEPT OF COMPUTER SCIENCE & ENGINEERING</span>
                    </div>

                    <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-slate-900 dark:text-white tracking-tight leading-none mb-6">
                        Future of Prototyping: <br class="hidden sm:inline" />
                        <span class="shimmer-text">Vibe Coding Special Lecture</span>
                    </h1>

                    <p class="text-lg text-slate-600 dark:text-slate-300 leading-relaxed mb-8">
                        Summarizing key outcomes and live build demonstrations from the PNU special seminar. Exploring rapid AI-orchestrated telemetry parsing, thermal data modeling, and real-time dynamic applications without conventional coding friction.
                    </p>

                    <!-- Lecture Metric Highlights -->
                    <div class="grid grid-cols-3 gap-4 max-w-xl mx-auto p-4 rounded-2xl glass-panel shadow-sm">
                        <div class="text-center">
                            <div class="text-2xl font-extrabold text-cyan-600 dark:text-cyan-400 font-mono">03</div>
                            <div class="text-xs text-slate-500 dark:text-slate-400 font-medium uppercase tracking-wider">Live Modules</div>
                        </div>
                        <div class="text-center border-x border-slate-200 dark:border-slate-700">
                            <div class="text-2xl font-extrabold text-violet-600 dark:text-violet-400 font-mono">100%</div>
                            <div class="text-xs text-slate-500 dark:text-slate-400 font-medium uppercase tracking-wider">Prompt Driven</div>
                        </div>
                        <div class="text-center">
                            <div class="text-2xl font-extrabold text-emerald-600 dark:text-emerald-400 font-mono">&lt; 10ms</div>
                            <div class="text-xs text-slate-500 dark:text-slate-400 font-medium uppercase tracking-wider">Latency Stream</div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Core Modules Section -->
        <section id="projects" class="py-12 bg-white/50 dark:bg-slate-900/50 relative">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                
                <div class="flex flex-col md:flex-row md:items-end justify-between mb-12">
                    <div>
                        <div class="text-xs font-mono text-cyan-600 dark:text-cyan-400 tracking-widest uppercase mb-1">// PRACTICAL HANDS-ON DEMOS</div>
                        <h2 class="text-3xl font-bold text-slate-900 dark:text-white tracking-tight">Lecture Deliverables & Core Cards</h2>
                    </div>
                    <p class="text-slate-500 dark:text-slate-400 text-sm mt-2 md:mt-0 max-w-md">
                        Interactive cards built live during the PNU Vibe Coding session. Click any card to open its dedicated project page.
                    </p>
                </div>

                <!-- 3 MAIN CARDS GRID -->
                <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
                    
                    <!-- CARD 1: Thermal Data Analysis 1 -> Links to p1.html -->
                    <div onclick="navigateTo('p1.html')" class="glass-panel-interactive rounded-3xl p-6 flex flex-col justify-between relative overflow-hidden group cursor-pointer">
                        <div class="h-1.5 w-full bg-gradient-to-r from-cyan-400 to-sky-500 absolute top-0 left-0"></div>

                        <div>
                            <div class="flex items-center justify-between mb-4 mt-1">
                                <span class="px-2.5 py-1 rounded-md bg-cyan-50 dark:bg-cyan-950 text-cyan-700 dark:text-cyan-300 text-xs font-mono font-semibold border border-cyan-100 dark:border-cyan-800">
                                    MODULE 01
                                </span>
                                <span class="text-xs text-slate-400 font-mono"><i class="fa-solid fa-bolt text-cyan-500 mr-1"></i> Fundamentals</span>
                            </div>

                            <h3 class="text-xl font-bold text-slate-900 dark:text-white group-hover:text-cyan-600 dark:group-hover:text-cyan-400 transition-colors flex items-center justify-between">
                                <span>Thermal Data Analysis I</span>
                                <i class="fa-solid fa-arrow-up-right-from-square text-xs opacity-0 group-hover:opacity-100 transition-opacity text-cyan-500"></i>
                            </h3>
                            <p class="text-sm text-slate-500 dark:text-slate-400 mt-2 mb-6">
                                Sensor telemetry signal parsing, heatmap matrix rendering, and baseline temperature threshold calibration.
                            </p>

                            <!-- Interactive Live Mini Dashboard Widget inside Card -->
                            <div class="bg-slate-50 dark:bg-slate-900/80 rounded-2xl p-4 border border-slate-100 dark:border-slate-800 mb-6" onclick="event.stopPropagation()">
                                <div class="flex items-center justify-between mb-3">
                                    <span class="text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider font-mono">Live Sensor Array #01</span>
                                    <span class="text-xs font-mono text-cyan-600 dark:text-cyan-400 font-bold" id="thermal1-val">34.2 °C</span>
                                </div>
                                
                                <!-- Canvas Chart 1 -->
                                <div class="h-32 relative">
                                    <canvas id="chart-thermal-1"></canvas>
                                </div>

                                <!-- Controls -->
                                <div class="mt-3 pt-3 border-t border-slate-200/60 dark:border-slate-800 flex items-center justify-between text-xs text-slate-500 dark:text-slate-400">
                                    <span>Gain Control:</span>
                                    <input type="range" id="slider-thermal-1" min="20" max="60" value="34" class="w-24 accent-cyan-500 cursor-pointer">
                                </div>
                            </div>
                        </div>

                        <!-- Card Footer -->
                        <div class="pt-4 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between">
                            <div class="flex items-center space-x-2 text-xs text-slate-500 dark:text-slate-400">
                                <i class="fa-solid fa-code-commit text-cyan-500"></i>
                                <span>AI Scripted Logic</span>
                            </div>
                            <button onclick="event.stopPropagation(); openModal('thermal1')" class="px-3.5 py-2 rounded-xl bg-slate-900 dark:bg-slate-100 text-white dark:text-slate-900 text-xs font-medium hover:bg-cyan-600 dark:hover:bg-cyan-400 transition-colors shadow-sm flex items-center space-x-1.5">
                                <span>Inspect Prompt</span>
                                <i class="fa-solid fa-arrow-right text-[10px]"></i>
                            </button>
                        </div>
                    </div>

                    <!-- CARD 2: Thermal Data Analysis 2 -> Links to p2.html -->
                    <div onclick="navigateTo('p2.html')" class="glass-panel-interactive rounded-3xl p-6 flex flex-col justify-between relative overflow-hidden group cursor-pointer">
                        <div class="h-1.5 w-full bg-gradient-to-r from-violet-400 to-fuchsia-500 absolute top-0 left-0"></div>

                        <div>
                            <div class="flex items-center justify-between mb-4 mt-1">
                                <span class="px-2.5 py-1 rounded-md bg-violet-50 dark:bg-violet-950 text-violet-700 dark:text-violet-300 text-xs font-mono font-semibold border border-violet-100 dark:border-violet-800">
                                    MODULE 02
                                </span>
                                <span class="text-xs text-slate-400 font-mono"><i class="fa-solid fa-chart-line text-violet-500 mr-1"></i> Advanced AI</span>
                            </div>

                            <h3 class="text-xl font-bold text-slate-900 dark:text-white group-hover:text-violet-600 dark:group-hover:text-violet-400 transition-colors flex items-center justify-between">
                                <span>Thermal Data Analysis II</span>
                                <i class="fa-solid fa-arrow-up-right-from-square text-xs opacity-0 group-hover:opacity-100 transition-opacity text-violet-500"></i>
                            </h3>
                            <p class="text-sm text-slate-500 dark:text-slate-400 mt-2 mb-6">
                                Real-time predictive thermal anomaly detection, statistical deviation alerts, and heat diffusion forecasting.
                            </p>

                            <!-- Interactive Live Mini Anomaly Widget inside Card -->
                            <div class="bg-slate-50 dark:bg-slate-900/80 rounded-2xl p-4 border border-slate-100 dark:border-slate-800 mb-6" onclick="event.stopPropagation()">
                                <div class="flex items-center justify-between mb-3">
                                    <span class="text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider font-mono">Anomaly Predictor</span>
                                    <span id="anomaly-badge" class="px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-emerald-100 text-emerald-700 dark:bg-emerald-950/80 dark:text-emerald-300">
                                        NORMAL
                                    </span>
                                </div>

                                <!-- Canvas Chart 2 -->
                                <div class="h-32 relative">
                                    <canvas id="chart-thermal-2"></canvas>
                                </div>

                                <!-- Trigger Anomaly Action -->
                                <div class="mt-3 pt-3 border-t border-slate-200/60 dark:border-slate-800 flex items-center justify-between">
                                    <span class="text-xs text-slate-500 dark:text-slate-400">Inject Spike:</span>
                                    <button onclick="triggerThermalSpike()" class="px-2.5 py-1 bg-violet-100 dark:bg-violet-900/50 text-violet-700 dark:text-violet-300 hover:bg-violet-200 dark:hover:bg-violet-800 rounded text-xs font-mono font-semibold transition-colors">
                                        + Simulate Spike
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- Card Footer -->
                        <div class="pt-4 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between">
                            <div class="flex items-center space-x-2 text-xs text-slate-500 dark:text-slate-400">
                                <i class="fa-solid fa-brain text-violet-500"></i>
                                <span>Spatial Predictive AI</span>
                            </div>
                            <button onclick="event.stopPropagation(); openModal('thermal2')" class="px-3.5 py-2 rounded-xl bg-slate-900 dark:bg-slate-100 text-white dark:text-slate-900 text-xs font-medium hover:bg-violet-600 dark:hover:bg-violet-400 transition-colors shadow-sm flex items-center space-x-1.5">
                                <span>Inspect Prompt</span>
                                <i class="fa-solid fa-arrow-right text-[10px]"></i>
                            </button>
                        </div>
                    </div>

                    <!-- CARD 3: The Weather App -> Links to p3.html -->
                    <div onclick="navigateTo('p3.html')" class="glass-panel-interactive rounded-3xl p-6 flex flex-col justify-between relative overflow-hidden group cursor-pointer">
                        <div class="h-1.5 w-full bg-gradient-to-r from-sky-400 to-emerald-400 absolute top-0 left-0"></div>

                        <div>
                            <div class="flex items-center justify-between mb-4 mt-1">
                                <span class="px-2.5 py-1 rounded-md bg-sky-50 dark:bg-sky-950 text-sky-700 dark:text-sky-300 text-xs font-mono font-semibold border border-sky-100 dark:border-sky-800">
                                    MODULE 03
                                </span>
                                <span class="text-xs text-slate-400 font-mono"><i class="fa-solid fa-cloud-sun text-sky-500 mr-1"></i> Full App Build</span>
                            </div>

                            <h3 class="text-xl font-bold text-slate-900 dark:text-white group-hover:text-sky-600 dark:group-hover:text-sky-400 transition-colors flex items-center justify-between">
                                <span>The Weather App</span>
                                <i class="fa-solid fa-arrow-up-right-from-square text-xs opacity-0 group-hover:opacity-100 transition-opacity text-sky-500"></i>
                            </h3>
                            <p class="text-sm text-slate-500 dark:text-slate-400 mt-2 mb-6">
                                End-to-end vibe-coded weather UI dashboard with live micro-climate telemetry, city switching, and dynamic forecasting.
                            </p>

                            <!-- Interactive Live Mini Weather Widget inside Card -->
                            <div class="bg-gradient-to-br from-slate-50 to-sky-50/50 dark:from-slate-900/90 dark:to-sky-950/30 rounded-2xl p-4 border border-slate-200/80 dark:border-slate-800 mb-6" onclick="event.stopPropagation()">
                                <div class="flex items-center justify-between mb-2">
                                    <select id="weather-city" onchange="updateWeather(this.value)" class="bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-xs font-semibold text-slate-800 dark:text-slate-200 rounded-lg px-2 py-1 focus:outline-none focus:ring-2 focus:ring-sky-400">
                                        <option value="busan">Busan (PNU Campus)</option>
                                        <option value="seoul">Seoul</option>
                                        <option value="tokyo">Tokyo</option>
                                    </select>
                                    <span class="text-[10px] font-mono text-slate-400">LIVE SYNC</span>
                                </div>

                                <div class="flex items-center justify-between my-3 px-1">
                                    <div>
                                        <div class="text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight" id="weather-temp">21°C</div>
                                        <div class="text-xs text-slate-500 dark:text-slate-400 font-medium" id="weather-condition">Partly Cloudy</div>
                                    </div>
                                    <div class="w-12 h-12 rounded-2xl bg-white dark:bg-slate-800 shadow-sm border border-slate-100 dark:border-slate-700 flex items-center justify-center text-sky-500 text-2xl" id="weather-icon">
                                        <i class="fa-solid fa-cloud-sun"></i>
                                    </div>
                                </div>

                                <div class="grid grid-cols-2 gap-2 text-[11px] pt-2 border-t border-slate-200/60 dark:border-slate-800 font-mono">
                                    <div class="text-slate-500 dark:text-slate-400">Humidity: <span class="text-slate-800 dark:text-slate-200 font-bold" id="weather-humidity">62%</span></div>
                                    <div class="text-slate-500 dark:text-slate-400">Wind: <span class="text-slate-800 dark:text-slate-200 font-bold" id="weather-wind">14 km/h</span></div>
                                </div>
                            </div>
                        </div>

                        <!-- Card Footer -->
                        <div class="pt-4 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between">
                            <div class="flex items-center space-x-2 text-xs text-slate-500 dark:text-slate-400">
                                <i class="fa-solid fa-wand-magic-sparkles text-sky-500"></i>
                                <span>Zero Manual Code</span>
                            </div>
                            <button onclick="event.stopPropagation(); openModal('weather')" class="px-3.5 py-2 rounded-xl bg-slate-900 dark:bg-slate-100 text-white dark:text-slate-900 text-xs font-medium hover:bg-sky-600 dark:hover:bg-sky-400 transition-colors shadow-sm flex items-center space-x-1.5">
                                <span>Inspect Prompt</span>
                                <i class="fa-solid fa-arrow-right text-[10px]"></i>
                            </button>
                        </div>
                    </div>

                </div>
            </div>
        </section>

        <!-- Vibe Coding Methodology & Lecture Key Takeaways -->
        <section id="vibe-coding" class="py-16 relative">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                
                <div class="glass-panel rounded-3xl p-8 lg:p-12 shadow-futuristic border border-slate-200">
                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
                        <div>
                            <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-cyan-50 border border-cyan-200 text-cyan-700 text-xs font-mono mb-4">
                                <i class="fa-solid fa-bolt"></i>
                                <span>LECTURE PHILOSOPHY</span>
                            </div>
                            <h2 class="text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight mb-4">
                                What is Vibe Coding?
                            </h2>
                            <p class="text-slate-600 dark:text-slate-300 leading-relaxed mb-6">
                                Highlighted in the PNU lecture, <strong>Vibe Coding</strong> shifts software engineering from manual syntax writing to intent orchestration. By articulating high-level architecture, thermal algorithms, and visual requirements to modern AI models, developers construct robust, deployable applications in minutes.
                            </p>

                            <div class="space-y-4">
                                <div class="flex items-start space-x-3">
                                    <div class="w-6 h-6 rounded-lg bg-cyan-100 dark:bg-cyan-950 text-cyan-700 dark:text-cyan-300 flex items-center justify-center text-xs mt-0.5 font-bold">1</div>
                                    <div>
                                        <h4 class="text-sm font-bold text-slate-900 dark:text-white">High-Level Intent Expressiveness</h4>
                                        <p class="text-xs text-slate-500 dark:text-slate-400">Formulating domain rules (e.g., thermal thresholds) via plain language.</p>
                                    </div>
                                </div>
                                <div class="flex items-start space-x-3">
                                    <div class="w-6 h-6 rounded-lg bg-violet-100 dark:bg-violet-950 text-violet-700 dark:text-violet-300 flex items-center justify-center text-xs mt-0.5 font-bold">2</div>
                                    <div>
                                        <h4 class="text-sm font-bold text-slate-900 dark:text-white">Iterative AI Canvas Feedback</h4>
                                        <p class="text-xs text-slate-500 dark:text-slate-400">Live previewing code outputs and tweaking prompts on the fly.</p>
                                    </div>
                                </div>
                                <div class="flex items-start space-x-3">
                                    <div class="w-6 h-6 rounded-lg bg-emerald-100 dark:bg-emerald-950 text-emerald-700 dark:text-emerald-300 flex items-center justify-center text-xs mt-0.5 font-bold">3</div>
                                    <div>
                                        <h4 class="text-sm font-bold text-slate-900 dark:text-white">Component Orchestration</h4>
                                        <p class="text-xs text-slate-500 dark:text-slate-400">Merging live canvas charts, telemetry hooks, and tailwind UI fluidly.</p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Interactive Terminal Simulator -->
                        <div class="bg-slate-900 rounded-2xl p-5 shadow-2xl text-slate-200 font-mono text-xs relative overflow-hidden border border-slate-800">
                            <!-- Terminal Header -->
                            <div class="flex items-center justify-between pb-3 mb-3 border-b border-slate-800">
                                <div class="flex space-x-2">
                                    <div class="w-3 h-3 rounded-full bg-rose-500"></div>
                                    <div class="w-3 h-3 rounded-full bg-amber-500"></div>
                                    <div class="w-3 h-3 rounded-full bg-emerald-500"></div>
                                </div>
                                <div class="text-slate-500 text-[10px]">pnu-vibe-engine ~ bash</div>
                            </div>

                            <!-- Terminal Content -->
                            <div class="space-y-3">
                                <p class="text-slate-400"># Pusan National University Lecture Demo Console</p>
                                <p><span class="text-cyan-400">user@pnu:~$</span> prompt-orchestrator --mode=vibe --target=thermal_dashboard</p>
                                <p class="text-emerald-400">✔ Parsing thermal dataset (PNU_Sensor_Logs_2026.json)</p>
                                <p class="text-emerald-400">✔ Generating Chart.js dynamic telemetry canvas</p>
                                <p class="text-emerald-400">✔ Injecting light-mode futuristic Tailwind layout</p>
                                <div class="p-3 bg-slate-800/80 rounded-lg border border-slate-700/60 text-slate-300 my-2">
                                    <span class="text-amber-400">VIBE PROMPT:</span> "Create a futuristic white-background card for PNU lecture showcasing real-time thermal analysis with dynamic controls."
                                </div>
                                <p class="text-sky-300 font-semibold animate-pulse">> Build compiled successfully in 1.42s.</p>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </section>

        <!-- PROMPT INSPECTION MODAL -->
        <div id="prompt-modal" class="fixed inset-0 z-50 hidden flex items-center justify-center p-4 bg-slate-900/40 dark:bg-black/60 backdrop-blur-sm transition-opacity">
            <div class="glass-panel w-full max-w-2xl rounded-3xl p-6 sm:p-8 shadow-2xl border border-slate-200 dark:border-slate-700 relative bg-white dark:bg-slate-900 transform transition-all scale-95 opacity-0" id="modal-container">
                
                <!-- Close Button -->
                <button onclick="closeModal()" class="absolute top-6 right-6 text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 w-8 h-8 rounded-full bg-slate-100 dark:bg-slate-800 flex items-center justify-center transition-colors">
                    <i class="fa-solid fa-xmark"></i>
                </button>

                <!-- Dynamic Modal Title -->
                <div class="flex items-center space-x-3 mb-4">
                    <div id="modal-icon" class="w-10 h-10 rounded-2xl bg-cyan-100 dark:bg-cyan-950 text-cyan-600 dark:text-cyan-400 flex items-center justify-center text-lg">
                        <i class="fa-solid fa-code"></i>
                    </div>
                    <div>
                        <h3 id="modal-title" class="text-xl font-bold text-slate-900 dark:text-white">Module Prompt Details</h3>
                        <p id="modal-subtitle" class="text-xs text-slate-500 dark:text-slate-400 font-mono">PNU Vibe Coding Archetype</p>
                    </div>
                </div>

                <!-- Modal Body -->
                <div class="space-y-4">
                    <div>
                        <label class="block text-xs font-mono font-semibold text-slate-500 dark:text-slate-400 uppercase mb-2">Natural Language Vibe Prompt Used</label>
                        <div id="modal-prompt-text" class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 text-xs font-mono text-slate-800 dark:text-slate-200 leading-relaxed">
                            <!-- Injected by JS -->
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-mono font-semibold text-slate-500 dark:text-slate-400 uppercase mb-2">Lecture Takeaway & Implementation Strategy</label>
                        <div id="modal-strategy-text" class="p-4 rounded-2xl bg-cyan-50/50 dark:bg-cyan-950/40 border border-cyan-100 dark:border-cyan-900/60 text-xs text-slate-700 dark:text-slate-300 leading-relaxed">
                            <!-- Injected by JS -->
                        </div>
                    </div>
                </div>

                <!-- Footer Actions -->
                <div class="mt-6 pt-4 border-t border-slate-100 dark:border-slate-800 flex justify-end">
                    <button onclick="closeModal()" class="px-5 py-2.5 rounded-xl bg-slate-900 dark:bg-slate-100 text-white dark:text-slate-900 text-xs font-semibold hover:bg-slate-800 dark:hover:bg-slate-200 transition-colors">
                        Close Inspector
                    </button>
                </div>
            </div>
        </div>

    </main>

    <!-- Footer -->
    <footer class="bg-white dark:bg-slate-950 border-t border-slate-200 dark:border-slate-800 py-8">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-4">
            <div class="flex items-center space-x-2 text-slate-500 dark:text-slate-400 text-xs">
                <i class="fa-solid fa-graduation-cap text-cyan-600 dark:text-cyan-400"></i>
                <span>Pusan National University Special Lecture Summary &copy; 2026</span>
            </div>
            <div class="flex items-center space-x-6 text-xs text-slate-400 dark:text-slate-500">
                <span class="hover:text-slate-600 dark:hover:text-slate-300 transition-colors">Adaptive Light/Dark Theme</span>
                <span class="hover:text-slate-600 dark:hover:text-slate-300 transition-colors">Vibe Coding Paradigm</span>
                <span class="hover:text-slate-600 dark:hover:text-slate-300 transition-colors">Thermal & Atmospheric Telemetry</span>
            </div>
        </div>
    </footer>

    <script>
        // --- NAVIGATION HANDLER ---
        function navigateTo(url) {
            window.location.href = url;
        }

        // --- THEME TOGGLE FUNCTIONALITY ---
        let isDarkMode = false;

        function toggleTheme() {
            isDarkMode = !isDarkMode;
            const htmlEl = document.documentElement;
            const themeIcon = document.getElementById('theme-icon');

            if (isDarkMode) {
                htmlEl.classList.add('dark');
                themeIcon.className = 'fa-solid fa-sun text-amber-400 text-sm';
            } else {
                htmlEl.classList.remove('dark');
                themeIcon.className = 'fa-solid fa-moon text-slate-700 text-sm';
            }

            // Update Chart.js themes dynamically
            updateChartTheme(chart1);
            updateChartTheme(chart2);
        }

        function updateChartTheme(chart) {
            if (!chart) return;
            const gridColor = isDarkMode ? 'rgba(51, 65, 85, 0.4)' : 'rgba(226, 232, 240, 0.6)';
            const tickColor = isDarkMode ? '#94A3B8' : '#64748B';

            chart.options.scales.y.grid.color = gridColor;
            chart.options.scales.y.ticks.color = tickColor;
            chart.update();
        }

        // Modal Data for each Card
        const modalContent = {
            thermal1: {
                title: "Thermal Data Analysis I — Fundamentals",
                subtitle: "MODULE 01 // SIGNAL PARSING & SENSOR MATRIX",
                icon: "fa-fire-flame-curved",
                iconBg: "bg-cyan-100 dark:bg-cyan-950 text-cyan-600 dark:text-cyan-400",
                prompt: `"Generate a single-file interactive HTML dashboard component for Thermal Data Analysis 1. Theme must be futuristic white with soft cyan accents. Include a live Chart.js linear telemetry visualization that displays baseline temperature readings with an interactive gain slider to adjust threshold response."`,
                strategy: "In this module, PNU lecture attendees learned how to prompt AI to parse multi-channel thermal sensor streams into real-time linear plots without writing manual boilerplate data structures."
            },
            thermal2: {
                title: "Thermal Data Analysis II — Predictive AI",
                subtitle: "MODULE 02 // ANOMALY DETECTION ENGINE",
                icon: "fa-chart-line",
                iconBg: "bg-violet-100 dark:bg-violet-950 text-violet-600 dark:text-violet-400",
                prompt: `"Build an advanced Thermal Data Analysis 2 card with futuristic light glassmorphic styling. Include a statistical anomaly prediction chart that auto-detects heat spikes. Add an interactive 'Simulate Spike' button that triggers live recalculation and visually alerts the user when temperatures exceed standard deviation boundaries."`,
                strategy: "Focused on spatial thermal behavior and machine learning prediction models. The vibe prompt instructed the model to handle standard deviation calculations dynamically on incoming telemetry arrays."
            },
            weather: {
                title: "The Weather App — Micro-Climate UI",
                subtitle: "MODULE 03 // ATMOSPHERIC FULL-STACK PROTOTYPE",
                icon: "fa-cloud-sun",
                iconBg: "bg-sky-100 dark:bg-sky-950 text-sky-600 dark:text-sky-400",
                prompt: `"Design a complete futuristic light-mode weather app component. Incorporate a city selection dropdown (Busan, Seoul, Tokyo), dynamic weather metric cards, fluid icon changes, and micro-climate indicators with soft shadows and no dark background elements."`,
                strategy: "Demonstrated how to build dynamic user interfaces with stateful city updates and clean typography in under 3 minutes using purely conversational prompts."
            }
        };

        // Modal Handler Functions
        function openModal(key) {
            const data = modalContent[key];
            if (!data) return;

            document.getElementById('modal-title').innerText = data.title;
            document.getElementById('modal-subtitle').innerText = data.subtitle;
            document.getElementById('modal-prompt-text').innerText = data.prompt;
            document.getElementById('modal-strategy-text').innerText = data.strategy;

            const iconEl = document.getElementById('modal-icon');
            iconEl.className = `w-10 h-10 rounded-2xl flex items-center justify-center text-lg ${data.iconBg}`;
            iconEl.innerHTML = `<i class="fa-solid ${data.icon}"></i>`;

            const modal = document.getElementById('prompt-modal');
            const container = document.getElementById('modal-container');
            
            modal.classList.remove('hidden');
            setTimeout(() => {
                container.classList.remove('scale-95', 'opacity-0');
                container.classList.add('scale-100', 'opacity-100');
            }, 10);
        }

        function closeModal() {
            const modal = document.getElementById('prompt-modal');
            const container = document.getElementById('modal-container');
            
            container.classList.remove('scale-100', 'opacity-100');
            container.classList.add('scale-95', 'opacity-0');
            
            setTimeout(() => {
                modal.classList.add('hidden');
            }, 200);
        }

        // Initialize Charts and Interactive Controls on Window Load
        let chart1, chart2;

        window.onload = function () {
            initThermalChart1();
            initThermalChart2();
        };

        // --- CHART 1: Thermal Data Analysis 1 ---
        function initThermalChart1() {
            const ctx = document.getElementById('chart-thermal-1').getContext('2d');
            
            const gradient = ctx.createLinearGradient(0, 0, 0, 120);
            gradient.addColorStop(0, 'rgba(14, 165, 233, 0.25)');
            gradient.addColorStop(1, 'rgba(14, 165, 233, 0.0)');

            const initialData = [31.2, 32.5, 33.1, 32.8, 34.2, 33.9, 34.5, 35.1];

            chart1 = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: ['T1', 'T2', 'T3', 'T4', 'T5', 'T6', 'T7', 'T8'],
                    datasets: [{
                        label: 'Temperature °C',
                        data: initialData,
                        borderColor: '#0EA5E9',
                        borderWidth: 2,
                        fill: true,
                        backgroundColor: gradient,
                        tension: 0.4,
                        pointRadius: 2,
                        pointHoverRadius: 5
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        x: { display: false },
                        y: { 
                            min: 20, 
                            max: 50,
                            grid: { color: 'rgba(226, 232, 240, 0.6)' },
                            ticks: { font: { size: 9, family: 'Inter' }, color: '#94A3B8' }
                        }
                    }
                }
            });

            const slider = document.getElementById('slider-thermal-1');
            const valDisplay = document.getElementById('thermal1-val');

            slider.addEventListener('input', (e) => {
                const val = parseFloat(e.target.value);
                valDisplay.innerText = `${val.toFixed(1)} °C`;
                
                chart1.data.datasets[0].data[chart1.data.datasets[0].data.length - 1] = val;
                chart1.update('none');
            });
        }

        // --- CHART 2: Thermal Data Analysis 2 ---
        function initThermalChart2() {
            const ctx = document.getElementById('chart-thermal-2').getContext('2d');

            const gradient = ctx.createLinearGradient(0, 0, 0, 120);
            gradient.addColorStop(0, 'rgba(139, 92, 246, 0.25)');
            gradient.addColorStop(1, 'rgba(139, 92, 246, 0.0)');

            chart2 = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: ['10m', '20m', '30m', '40m', '50m', '60m', '70m'],
                    datasets: [{
                        label: 'Thermal Predictor',
                        data: [42.1, 41.8, 42.5, 43.0, 42.2, 42.7, 43.1],
                        borderColor: '#8B5CF6',
                        borderWidth: 2,
                        fill: true,
                        backgroundColor: gradient,
                        tension: 0.3,
                        pointBackgroundColor: '#8B5CF6'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        x: { display: false },
                        y: { 
                            min: 35, 
                            max: 75,
                            grid: { color: 'rgba(226, 232, 240, 0.6)' },
                            ticks: { font: { size: 9, family: 'Inter' }, color: '#94A3B8' }
                        }
                    }
                }
            });
        }

        function triggerThermalSpike() {
            if (!chart2) return;
            
            const badge = document.getElementById('anomaly-badge');
            
            chart2.data.datasets[0].data = [42.1, 41.8, 42.5, 43.0, 58.4, 69.2, 73.5];
            chart2.data.datasets[0].borderColor = '#EF4444';
            chart2.update();

            badge.className = 'px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-rose-100 text-rose-700 dark:bg-rose-950 dark:text-rose-300 animate-pulse';
            badge.innerText = 'SPIKE DETECTED (>70°C)';

            setTimeout(() => {
                chart2.data.datasets[0].data = [42.1, 41.8, 42.5, 43.0, 42.2, 42.7, 43.1];
                chart2.data.datasets[0].borderColor = '#8B5CF6';
                chart2.update();

                badge.className = 'px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-emerald-100 text-emerald-700 dark:bg-emerald-950/80 dark:text-emerald-300';
                badge.innerText = 'NORMAL';
            }, 4000);
        }

        // --- WEATHER APP CARD INTERACTIVITY ---
        const weatherData = {
            busan: { temp: "21°C", condition: "Partly Cloudy (PNU)", humidity: "62%", wind: "14 km/h", icon: "fa-cloud-sun", color: "text-sky-500" },
            seoul: { temp: "18°C", condition: "Breezy & Crisp", humidity: "54%", wind: "19 km/h", icon: "fa-wind", color: "text-cyan-500" },
            tokyo: { temp: "23°C", condition: "Clear Sky", humidity: "48%", wind: "11 km/h", icon: "fa-sun", color: "text-amber-500" }
        };

        function updateWeather(cityKey) {
            const data = weatherData[cityKey];
            if (!data) return;

            document.getElementById('weather-temp').innerText = data.temp;
            document.getElementById('weather-condition').innerText = data.condition;
            document.getElementById('weather-humidity').innerText = data.humidity;
            document.getElementById('weather-wind').innerText = data.wind;

            const iconContainer = document.getElementById('weather-icon');
            iconContainer.className = `w-12 h-12 rounded-2xl bg-white dark:bg-slate-800 shadow-sm border border-slate-100 dark:border-slate-700 flex items-center justify-center text-2xl ${data.color}`;
            iconContainer.innerHTML = `<i class="fa-solid ${data.icon}"></i>`;
        }
    </script>
</body>
</html>
